{
  "name": "lunaticflow",
  "displayName": "LunaticFlow",
  "description": "Work with coding agents in sprints: plan them as a graph, review each sprint in the changed files (approve, reject, comment on lines), and see what changed since your review. Also: tab groups and Markdown review comments.",
  "version": "0.2611.3",
  "publisher": "mahyarsamani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahyarsamani/LunaticFlow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": ["workspace"],
  "categories": ["Other"],
  "keywords": ["agents", "claude", "sprints", "code review", "tabs", "groups", "markdown", "review", "comments"],
  "activationEvents": ["onStartupFinished", "onWebviewPanel:mdReview.preview", "onFileSystem:lunaticflow"],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tabGroupsContainer",
          "title": "LunaticFlow",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "tabGroupsContainer": [
        {
          "id": "lunaticflowView",
          "name": "Flow",
          "icon": "$(git-pull-request)"
        },
        {
          "id": "tabGroupsView",
          "name": "Groups",
          "icon": "images/tab-groups-icon.svg"
        },
        {
          "id": "reviewCommentsView",
          "name": "Review Comments",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lunaticflowView",
        "contents": "No sprint plans found in this workspace or under the agent roots.\nAn agent starts one with `lf init` and `lf plan add`.\n[Set Up LunaticFlow in a Repository](command:lunaticflow.initRepo)\n[Install the lf CLI](command:lunaticflow.installCli)"
      },
      {
        "view": "tabGroupsView",
        "contents": "No tab groups yet.\n[New Group](command:tabGroups.createGroup)\n[Group All Open Tabs](command:tabGroups.addCurrentFilesToNewGroup)"
      },
      {
        "view": "reviewCommentsView",
        "contents": "No review comments yet. Open a Markdown file and start a review.\n[Open Review Preview](command:mdReview.openPreview)"
      }
    ],
    "commands": [
      { "command": "lunaticflow.refresh", "title": "Refresh", "icon": "$(refresh)", "category": "LunaticFlow" },
      { "command": "lunaticflow.nextReview", "title": "Review Next Sprint", "icon": "$(eye)", "category": "LunaticFlow" },
      { "command": "lunaticflow.showPlan", "title": "Show Plan Graph and Timeline", "icon": "$(type-hierarchy)", "category": "LunaticFlow" },
      { "command": "lunaticflow.initRepo", "title": "Set Up in a Repository", "category": "LunaticFlow" },
      { "command": "lunaticflow.installCli", "title": "Install the lf CLI for Agents", "category": "LunaticFlow" },
      { "command": "lunaticflow.checkForUpdates", "title": "Check for Updates", "category": "LunaticFlow" },
      { "command": "lunaticflow.openPlayground", "title": "Open the Agent Playground", "category": "LunaticFlow" },
      { "command": "lunaticflow.approveHunk", "title": "Approve Change", "icon": "$(check)", "category": "LunaticFlow" },
      { "command": "lunaticflow.rejectHunk", "title": "Reject Change", "icon": "$(close)", "category": "LunaticFlow" },
      { "command": "lunaticflow.clearHunk", "title": "Undo Decision", "icon": "$(discard)", "category": "LunaticFlow" },
      { "command": "lunaticflow.commentHunk", "title": "Comment on Change", "icon": "$(comment)", "category": "LunaticFlow" },
      { "command": "lunaticflow.approveFile", "title": "Approve File", "icon": "$(check-all)", "category": "LunaticFlow" },
      { "command": "lunaticflow.submitReview", "title": "Send Review to Agent", "icon": "$(send)", "category": "LunaticFlow" },
      { "command": "lunaticflow.nextChange", "title": "Next Change", "icon": "$(arrow-down)", "category": "LunaticFlow" },
      { "command": "lunaticflow.previousChange", "title": "Previous Change", "icon": "$(arrow-up)", "category": "LunaticFlow" },
      { "command": "lunaticflow.nextFile", "title": "Next Changed File", "icon": "$(arrow-right)", "category": "LunaticFlow" },
      { "command": "lunaticflow.previousFile", "title": "Previous Changed File", "icon": "$(arrow-left)", "category": "LunaticFlow" },
      { "command": "lunaticflow.nextUndecided", "title": "Next Change Without a Decision", "icon": "$(debug-step-over)", "category": "LunaticFlow" },
      { "command": "lunaticflow.node.approveHunk", "title": "Approve", "icon": "$(check)" },
      { "command": "lunaticflow.node.rejectHunk", "title": "Reject", "icon": "$(close)" },
      { "command": "lunaticflow.node.clearHunk", "title": "Undo Decision", "icon": "$(discard)" },
      { "command": "lunaticflow.node.commentHunk", "title": "Comment", "icon": "$(comment)" },
      { "command": "lunaticflow.node.approveFile", "title": "Approve File", "icon": "$(check-all)" },
      { "command": "lunaticflow.node.submitReview", "title": "Send Review", "icon": "$(send)" },
      { "command": "lunaticflow.node.openRound", "title": "Review", "icon": "$(eye)" },
      { "command": "lunaticflow.node.resolveThread", "title": "Resolve", "icon": "$(check)" },
      { "command": "lunaticflow.node.reopenThread", "title": "Reopen", "icon": "$(issue-reopened)" },
      { "command": "lunaticflow.resumeResearch", "title": "Open Session", "icon": "$(comment-discussion)" },
      { "command": "lunaticflow.comment.create", "title": "Comment", "enablement": "!commentIsEmpty" },
      { "command": "lunaticflow.comment.reply", "title": "Reply", "enablement": "!commentIsEmpty" },
      { "command": "lunaticflow.comment.cancel", "title": "Cancel" },
      { "command": "lunaticflow.comment.resolve", "title": "Resolve", "icon": "$(check)" },
      { "command": "lunaticflow.comment.reopen", "title": "Reopen", "icon": "$(issue-reopened)" },
      { "command": "lunaticflow.comment.delete", "title": "Delete Draft", "icon": "$(trash)" },
      { "command": "tabGroups.createGroup", "title": "New Group", "icon": "$(add)", "category": "Tab Groups" },
      { "command": "tabGroups.renameGroup", "title": "Rename Group", "icon": "$(edit)", "category": "Tab Groups" },
      { "command": "tabGroups.deleteGroup", "title": "Delete Group", "icon": "$(trash)", "category": "Tab Groups" },
      { "command": "tabGroups.addActiveFile", "title": "Add to Tab Group…", "icon": "$(plus)", "category": "Tab Groups" },
      { "command": "tabGroups.addActiveFileToGroup", "title": "Add Active File Here", "icon": "$(plus)", "category": "Tab Groups" },
      { "command": "tabGroups.addOpenTabsToGroup", "title": "Add All Open Tabs Here", "icon": "$(files)", "category": "Tab Groups" },
      { "command": "tabGroups.openAllInGroup", "title": "Open All", "icon": "$(go-to-file)", "category": "Tab Groups" },
      { "command": "tabGroups.closeAllInGroup", "title": "Close All", "icon": "$(close-all)", "category": "Tab Groups" },
      { "command": "tabGroups.switchToGroup", "title": "Switch to Group", "icon": "$(arrow-swap)", "category": "Tab Groups" },
      { "command": "tabGroups.switchToGroupPick", "title": "Switch to Group…", "category": "Tab Groups" },
      { "command": "tabGroups.removeFileFromGroup", "title": "Remove from Group", "icon": "$(close)", "category": "Tab Groups" },
      { "command": "tabGroups.openFile", "title": "Open File", "icon": "$(go-to-file)", "category": "Tab Groups" },
      { "command": "tabGroups.setGroupColor", "title": "Change Color", "icon": "$(symbol-color)", "category": "Tab Groups" },
      { "command": "tabGroups.addCurrentFilesToNewGroup", "title": "Group All Open Tabs into New Group", "icon": "$(group-by-ref-type)", "category": "Tab Groups" },
      { "command": "tabGroups.copyGroupComments", "title": "Copy Review Comments for Group", "icon": "$(comment-discussion)", "category": "Tab Groups" },
      { "command": "tabGroups.refresh", "title": "Refresh", "icon": "$(refresh)", "category": "Tab Groups" },

      { "command": "mdReview.openPreview", "title": "Open Review Preview", "icon": "$(comment-discussion)", "category": "Markdown Review" },
      { "command": "mdReview.copyComments", "title": "Copy Comments (Current File)", "icon": "$(copy)", "category": "Markdown Review" },
      { "command": "mdReview.copyAllComments", "title": "Copy Comments (All Files)", "icon": "$(copy)", "category": "Markdown Review" },
      { "command": "mdReview.exportComments", "title": "Export Comments to New Document", "icon": "$(export)", "category": "Markdown Review" },
      { "command": "mdReview.clearComments", "title": "Clear Comments (Current File)", "icon": "$(clear-all)", "category": "Markdown Review" },
      { "command": "mdReview.clearAllComments", "title": "Clear Comments (All Files)", "icon": "$(clear-all)", "category": "Markdown Review" },
      { "command": "mdReview.editComment", "title": "Edit Comment", "icon": "$(edit)", "category": "Markdown Review" },
      { "command": "mdReview.deleteComment", "title": "Delete Comment", "icon": "$(trash)", "category": "Markdown Review" },
      { "command": "mdReview.revealComment", "title": "Go to Comment", "category": "Markdown Review" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "lunaticflow.approveHunk", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.rejectHunk", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.clearHunk", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.commentHunk", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.approveFile", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.nextChange", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.previousChange", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.nextFile", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.previousFile", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.nextUndecided", "when": "resourceScheme == lunaticflow" },
        { "command": "lunaticflow.node.approveHunk", "when": "false" },
        { "command": "lunaticflow.node.rejectHunk", "when": "false" },
        { "command": "lunaticflow.node.clearHunk", "when": "false" },
        { "command": "lunaticflow.node.commentHunk", "when": "false" },
        { "command": "lunaticflow.node.approveFile", "when": "false" },
        { "command": "lunaticflow.node.submitReview", "when": "false" },
        { "command": "lunaticflow.node.openRound", "when": "false" },
        { "command": "lunaticflow.node.resolveThread", "when": "false" },
        { "command": "lunaticflow.node.reopenThread", "when": "false" },
        { "command": "lunaticflow.resumeResearch", "when": "false" },
        { "command": "lunaticflow.comment.create", "when": "false" },
        { "command": "lunaticflow.comment.reply", "when": "false" },
        { "command": "lunaticflow.comment.cancel", "when": "false" },
        { "command": "lunaticflow.comment.resolve", "when": "false" },
        { "command": "lunaticflow.comment.reopen", "when": "false" },
        { "command": "lunaticflow.comment.delete", "when": "false" },
        { "command": "tabGroups.renameGroup", "when": "false" },
        { "command": "tabGroups.deleteGroup", "when": "false" },
        { "command": "tabGroups.addActiveFileToGroup", "when": "false" },
        { "command": "tabGroups.addOpenTabsToGroup", "when": "false" },
        { "command": "tabGroups.openAllInGroup", "when": "false" },
        { "command": "tabGroups.closeAllInGroup", "when": "false" },
        { "command": "tabGroups.switchToGroup", "when": "false" },
        { "command": "tabGroups.removeFileFromGroup", "when": "false" },
        { "command": "tabGroups.openFile", "when": "false" },
        { "command": "tabGroups.setGroupColor", "when": "false" },
        { "command": "tabGroups.copyGroupComments", "when": "false" },
        { "command": "mdReview.editComment", "when": "false" },
        { "command": "mdReview.deleteComment", "when": "false" },
        { "command": "mdReview.revealComment", "when": "false" }
      ],
      "view/title": [
        { "command": "lunaticflow.nextReview", "when": "view == lunaticflowView", "group": "navigation@1" },
        { "command": "lunaticflow.showPlan", "when": "view == lunaticflowView", "group": "navigation@2" },
        { "command": "lunaticflow.refresh", "when": "view == lunaticflowView", "group": "navigation@3" },
        { "command": "lunaticflow.initRepo", "when": "view == lunaticflowView", "group": "2_setup@1" },
        { "command": "lunaticflow.installCli", "when": "view == lunaticflowView", "group": "2_setup@2" },
        { "command": "lunaticflow.checkForUpdates", "when": "view == lunaticflowView", "group": "2_setup@3" },
        { "command": "lunaticflow.openPlayground", "when": "view == lunaticflowView", "group": "2_setup@4" },
        { "command": "tabGroups.createGroup", "when": "view == tabGroupsView", "group": "navigation@1" },
        { "command": "tabGroups.addCurrentFilesToNewGroup", "when": "view == tabGroupsView", "group": "navigation@2" },
        { "command": "tabGroups.refresh", "when": "view == tabGroupsView", "group": "navigation@3" },
        { "command": "mdReview.copyAllComments", "when": "view == reviewCommentsView", "group": "navigation@1" },
        { "command": "mdReview.exportComments", "when": "view == reviewCommentsView", "group": "navigation@2" },
        { "command": "mdReview.clearAllComments", "when": "view == reviewCommentsView", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "lunaticflow.showPlan", "when": "view == lunaticflowView && viewItem == flowRepo", "group": "inline@1" },
        { "command": "lunaticflow.node.openRound", "when": "view == lunaticflowView && viewItem == sprint-in_review", "group": "inline@1" },
        { "command": "lunaticflow.node.submitReview", "when": "view == lunaticflowView && viewItem == sprint-in_review", "group": "inline@2" },
        { "command": "lunaticflow.node.approveFile", "when": "view == lunaticflowView && viewItem == flowFile-open", "group": "inline@1" },
        { "command": "lunaticflow.node.approveHunk", "when": "view == lunaticflowView && viewItem =~ /^flowHunk-(undecided|rejected)$/", "group": "inline@1" },
        { "command": "lunaticflow.node.rejectHunk", "when": "view == lunaticflowView && viewItem =~ /^flowHunk-(undecided|approved)$/", "group": "inline@2" },
        { "command": "lunaticflow.node.commentHunk", "when": "view == lunaticflowView && viewItem =~ /^flowHunk-/", "group": "inline@3" },
        { "command": "lunaticflow.node.clearHunk", "when": "view == lunaticflowView && viewItem =~ /^flowHunk-(approved|rejected)$/", "group": "inline@4" },
        { "command": "lunaticflow.node.resolveThread", "when": "view == lunaticflowView && viewItem == flowThread-open", "group": "inline@1" },
        { "command": "lunaticflow.node.reopenThread", "when": "view == lunaticflowView && viewItem == flowThread-resolved", "group": "inline@1" },
        { "command": "lunaticflow.resumeResearch", "when": "view == lunaticflowView && viewItem == flowResearch", "group": "inline@1" },
        { "command": "tabGroups.switchToGroup", "when": "view == tabGroupsView && viewItem == group", "group": "inline@1" },
        { "command": "tabGroups.openAllInGroup", "when": "view == tabGroupsView && viewItem == group", "group": "inline@2" },
        { "command": "tabGroups.closeAllInGroup", "when": "view == tabGroupsView && viewItem == group", "group": "inline@3" },
        { "command": "tabGroups.switchToGroup", "when": "view == tabGroupsView && viewItem == group", "group": "1_group@0" },
        { "command": "tabGroups.openAllInGroup", "when": "view == tabGroupsView && viewItem == group", "group": "1_group@1" },
        { "command": "tabGroups.closeAllInGroup", "when": "view == tabGroupsView && viewItem == group", "group": "1_group@2" },
        { "command": "tabGroups.addActiveFileToGroup", "when": "view == tabGroupsView && viewItem == group", "group": "2_add@1" },
        { "command": "tabGroups.addOpenTabsToGroup", "when": "view == tabGroupsView && viewItem == group", "group": "2_add@2" },
        { "command": "tabGroups.copyGroupComments", "when": "view == tabGroupsView && viewItem == group", "group": "3_review@1" },
        { "command": "tabGroups.setGroupColor", "when": "view == tabGroupsView && viewItem == group", "group": "4_edit@1" },
        { "command": "tabGroups.renameGroup", "when": "view == tabGroupsView && viewItem == group", "group": "4_edit@2" },
        { "command": "tabGroups.deleteGroup", "when": "view == tabGroupsView && viewItem == group", "group": "5_delete@1" },

        { "command": "tabGroups.removeFileFromGroup", "when": "view == tabGroupsView && viewItem =~ /^file/", "group": "inline@1" },
        { "command": "tabGroups.openFile", "when": "view == tabGroupsView && viewItem =~ /^file/", "group": "1_file@1" },
        { "command": "mdReview.openPreview", "when": "view == tabGroupsView && viewItem == file-md", "group": "1_file@2" },
        { "command": "tabGroups.removeFileFromGroup", "when": "view == tabGroupsView && viewItem =~ /^file/", "group": "2_file@1" },

        { "command": "mdReview.openPreview", "when": "view == reviewCommentsView && viewItem == reviewFile", "group": "inline@1" },
        { "command": "mdReview.copyComments", "when": "view == reviewCommentsView && viewItem == reviewFile", "group": "inline@2" },
        { "command": "mdReview.openPreview", "when": "view == reviewCommentsView && viewItem == reviewFile", "group": "1_file@1" },
        { "command": "mdReview.copyComments", "when": "view == reviewCommentsView && viewItem == reviewFile", "group": "1_file@2" },
        { "command": "mdReview.clearComments", "when": "view == reviewCommentsView && viewItem == reviewFile", "group": "2_file@1" },
        { "command": "mdReview.editComment", "when": "view == reviewCommentsView && viewItem == reviewComment", "group": "inline@1" },
        { "command": "mdReview.deleteComment", "when": "view == reviewCommentsView && viewItem == reviewComment", "group": "inline@2" },
        { "command": "mdReview.editComment", "when": "view == reviewCommentsView && viewItem == reviewComment", "group": "1_comment@1" },
        { "command": "mdReview.deleteComment", "when": "view == reviewCommentsView && viewItem == reviewComment", "group": "1_comment@2" }
      ],
      "editor/title": [
        { "command": "mdReview.openPreview", "when": "editorLangId == markdown", "group": "navigation" },
        { "command": "lunaticflow.previousFile", "when": "resourceScheme == lunaticflow", "group": "navigation@1" },
        { "command": "lunaticflow.previousChange", "when": "resourceScheme == lunaticflow", "group": "navigation@2" },
        { "command": "lunaticflow.nextChange", "when": "resourceScheme == lunaticflow", "group": "navigation@3" },
        { "command": "lunaticflow.nextFile", "when": "resourceScheme == lunaticflow", "group": "navigation@4" },
        { "command": "lunaticflow.approveFile", "when": "resourceScheme == lunaticflow", "group": "navigation@5" },
        { "command": "lunaticflow.submitReview", "when": "resourceScheme == lunaticflow", "group": "navigation@6" }
      ],
      "editor/context": [
        { "command": "lunaticflow.approveHunk", "when": "resourceScheme == lunaticflow", "group": "0_lunaticflow@1" },
        { "command": "lunaticflow.rejectHunk", "when": "resourceScheme == lunaticflow", "group": "0_lunaticflow@2" },
        { "command": "lunaticflow.commentHunk", "when": "resourceScheme == lunaticflow", "group": "0_lunaticflow@3" },
        { "command": "lunaticflow.clearHunk", "when": "resourceScheme == lunaticflow", "group": "0_lunaticflow@4" }
      ],
      "comments/commentThread/context": [
        { "command": "lunaticflow.comment.create", "when": "commentController == lunaticflow && commentThreadIsEmpty", "group": "inline@1" },
        { "command": "lunaticflow.comment.reply", "when": "commentController == lunaticflow && !commentThreadIsEmpty", "group": "inline@1" },
        { "command": "lunaticflow.comment.cancel", "when": "commentController == lunaticflow && commentThreadIsEmpty", "group": "inline@2" }
      ],
      "comments/commentThread/title": [
        { "command": "lunaticflow.comment.resolve", "when": "commentController == lunaticflow && commentThread =~ /^open/", "group": "inline@1" },
        { "command": "lunaticflow.comment.reopen", "when": "commentController == lunaticflow && commentThread == resolved", "group": "inline@1" },
        { "command": "lunaticflow.comment.delete", "when": "commentController == lunaticflow && commentThread == open-draft", "group": "inline@2" }
      ],
      "editor/title/context": [
        { "command": "tabGroups.addActiveFile", "group": "tabgroups@1" }
      ],
      "explorer/context": [
        { "command": "tabGroups.addActiveFile", "when": "!explorerResourceIsFolder", "group": "tabgroups@1" },
        { "command": "mdReview.openPreview", "when": "resourceLangId == markdown", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "lunaticflow.approveHunk", "key": "ctrl+alt+y", "mac": "cmd+alt+y", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.rejectHunk", "key": "ctrl+alt+n", "mac": "cmd+alt+n", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.commentHunk", "key": "ctrl+alt+m", "mac": "cmd+alt+m", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.nextChange", "key": "ctrl+alt+]", "mac": "cmd+alt+]", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.previousChange", "key": "ctrl+alt+[", "mac": "cmd+alt+[", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.nextFile", "key": "ctrl+shift+alt+]", "mac": "shift+cmd+alt+]", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.previousFile", "key": "ctrl+shift+alt+[", "mac": "shift+cmd+alt+[", "when": "resourceScheme == lunaticflow" },
      { "command": "lunaticflow.nextUndecided", "key": "ctrl+alt+j", "mac": "cmd+alt+j", "when": "resourceScheme == lunaticflow" },
      {
        "command": "mdReview.openPreview",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == markdown"
      },
      {
        "command": "tabGroups.switchToGroupPick",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": [
      {
        "title": "LunaticFlow",
        "properties": {
          "lunaticflow.agentPlayground": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "markdownDescription": "Base directory where agents make their own clones and write their files, one subdirectory per work package (for example `/scr/msamani/agents`, so `lf clone dx100` makes `/scr/msamani/agents/dx100/<repo>` on branch `agent/dx100`). Set it in your user or remote settings, and override it per workspace. `~`, `${userHome}` and `${env:NAME}` are expanded. Plans in the playground appear in the Flow view, and the `lf` CLI reads it from `~/.config/lunaticflow/config.json`, which LunaticFlow keeps up to date."
          },
          "lunaticflow.review.advanceOnDecision": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "In a review diff, move on to the next change after **Approve** or **Reject**. **Comment** and **Undo** stay on the change, and deciding from the Flow view never opens a diff."
          },
          "lunaticflow.agentRoots": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "scope": "machine-overridable",
            "description": "More folders to search for agents' clones with a .lunaticflow plan, besides the agent playground. Missing folders are ignored."
          },
          "lunaticflow.scanDepth": {
            "type": "number",
            "default": 2,
            "description": "How many folder levels below each workspace folder and agent root to look for .lunaticflow plans (2 finds projects/sift in the PhD repository)."
          },
          "lunaticflow.notify": {
            "type": "boolean",
            "default": true,
            "description": "Show a notification when an agent hands a sprint over for review."
          },
          "lunaticflow.reviewerName": {
            "type": "string",
            "default": "You",
            "description": "Your name on review comments."
          },
          "lunaticflow.checkForUpdates": {
            "type": "boolean",
            "default": true,
            "description": "Check GitHub once a day for a newer LunaticFlow release and offer a one-click update."
          },
          "lunaticflow.updateRepository": {
            "type": "string",
            "default": "mahyarsamani/LunaticFlow",
            "description": "The GitHub repository (owner/name) whose releases carry the LunaticFlow .vsix."
          }
        }
      },
      {
        "title": "Tab Groups",
        "properties": {
          "lunaticflow.tabGroups.showFileIcons": {
            "type": "boolean",
            "default": true,
            "description": "Show file type icons in the groups panel."
          },
          "lunaticflow.tabGroups.showFilePath": {
            "type": "boolean",
            "default": false,
            "description": "Show the workspace-relative path instead of just the file name."
          },
          "lunaticflow.tabGroups.switchClosesOtherTabs": {
            "type": "boolean",
            "default": true,
            "description": "When switching to a group, close open tabs that are not in it. Tabs with unsaved changes and pinned tabs are always kept."
          },
          "lunaticflow.tabGroups.showStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Show the current tab group in the status bar."
          }
        }
      },
      {
        "title": "Markdown Review",
        "properties": {
          "lunaticflow.markdownReview.separator": {
            "type": "string",
            "default": "; ",
            "description": "Text placed between several comments on the same line."
          },
          "lunaticflow.markdownReview.includeQuote": {
            "type": "boolean",
            "default": false,
            "description": "Put the selected text in quotes before the comment when exporting (only for comments made on a text selection)."
          },
          "lunaticflow.markdownReview.absolutePaths": {
            "type": "boolean",
            "default": false,
            "description": "Export absolute file paths instead of workspace-relative ones."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node out/test/format.test.js && node out/test/flow.test.js && node out/test/flow.ext.test.js && node out/test/update.test.js && python3 cli/test_lf.py && cmp cli/lf.py claude-plugin/bin/lf.py",
    "package": "vsce package --skip-license -o lunaticflow-$npm_package_version.vsix",
    "release": "npm run compile && node scripts/release.js",
    "sync-plugin": "cp cli/lf.py claude-plugin/bin/lf.py",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.0.0"
  }
